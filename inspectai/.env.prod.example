# 复制为 .env.prod 放在服务器上，填真实值。
# 注意：v2 起，所有敏感凭据（密码 / token / API key）都通过 Docker secret 文件
# 注入容器，不再走环境变量。这里只保留**非敏感**的部署配置。
# 敏感值放在 ./secrets/ 下的同名文件里，操作见 docs/DEPLOY.md。

COMPOSE_PROJECT_NAME=inspectai

# ===== 非敏感 =====

MYSQL_DATABASE=inspectai
MYSQL_USER=inspectai

# Optional: 仅 scripts/init-mysql-db.py 使用（已有 MySQL 集群时建库用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_VISION_FALLBACK=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

INSPECTAI_ADMIN_USER=admin
INSPECTAI_ADMIN_NAME=张管理员

# 逗号分隔的精确 origin，例：https://inspect.example.com
CORS_ALLOWED_ORIGINS=
TMP_IMAGE_TTL_HOURS=24

WEWORK_TRUSTED_DOMAIN=
WEWORK_CORP_ID=
WEWORK_AGENT_ID=

# ===== 敏感凭据：放在 ./secrets/ 下，不要写在这个文件里 =====
# 见 docs/DEPLOY.md 中"准备 secret 文件"一节
#   ./secrets/dashscope_api_key
#   ./secrets/mysql_password
#   ./secrets/mysql_root_password
#   ./secrets/mysql_dsn                  (由部署脚本生成完整 DSN)
#   ./secrets/inspectai_auth_token
#   ./secrets/inspectai_supervisor_token
#   ./secrets/inspectai_admin_password
#   ./secrets/wework_app_secret          (可选，启用企业微信时)
