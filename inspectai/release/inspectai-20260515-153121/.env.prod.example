# Copy to .env.prod on the server and fill real values before deployment.

COMPOSE_PROJECT_NAME=inspectai

MYSQL_DATABASE=inspectai
MYSQL_USER=inspectai
# Keep MySQL passwords alphanumeric for this DSN format.
# Avoid special characters like @ : / ? # unless you URL-encode them.
MYSQL_PASSWORD=change_me_mysql_password
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password

# Optional: only used by scripts/init-mysql-db.py for an existing MySQL server.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change_me_mysql_root_password

DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_VISION_FALLBACK=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

# Shared access token for the current lightweight production mode.
# Frontend will prompt once and store it in browser localStorage.
INSPECTAI_AUTH_TOKEN=change_me_app_auth_token
TMP_IMAGE_TTL_HOURS=24

WEWORK_TRUSTED_DOMAIN=
WEWORK_CORP_ID=
WEWORK_AGENT_ID=
WEWORK_APP_SECRET=
